<mxfile host="app.diagrams.net" type="device"><diagram id="p_overview" name="0. Navigation Map"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Complete System Flowchart — Navigation Map" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1600" height="30" as="geometry"/></mxCell><mxCell id="n2" value="Every page of the Stall Management System, grouped by who uses it. Click any box to open its detailed page (every button and action). Arrows show how users move between pages." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2200" height="22" as="geometry"/></mxCell><mxCell id="n3" value="Guest (not signed in)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#BBBBBB;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="2160" height="190" as="geometry"/></mxCell><UserObject label="Home&lt;br&gt;/" link="data:page/id,p_home" id="n4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="160" width="210" height="90" as="geometry"/></mxCell></UserObject><UserObject label="Browse Stalls&lt;br&gt;/stalls" link="data:page/id,p_browse" id="n5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="160" width="210" height="90" as="geometry"/></mxCell></UserObject><UserObject label="Sign-in, Register &amp;amp; Forgot-password modals&lt;br&gt;/login" link="data:page/id,p_auth" id="n6"><mxCell style="