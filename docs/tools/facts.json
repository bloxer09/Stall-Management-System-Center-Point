  "schedule": [
    {
      "command": "billing:generate-invoices",
      "when": "monthlyOn(1, '00:00')"
    },
    {
      "command": "stallm:send-reminders",
      "when": "dailyAt('08:00')"
    },
    {
      "command": "stallm:notify-expiring-leases",
      "when": "dailyAt('07:00')"
    },
    {
      "command": "stallm:flag-overdue",
      "when": "dailyAt('08:30')"
    },
    {
      "command": "stallm:backup",
      "when": "dailyAt('02:00')"
    }
  ],
