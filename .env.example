APP_NAME=StallManage
APP_URL=http://localhost
APP_BASE_PATH=/stallm
ENABLE_2FA=true
APP_DEBUG=0
APP_ERROR_PAGE_ENABLED=1

DB_HOST=localhost
DB_NAME=stallm
DB_USER=root
DB_PASS=

SESSION_NAME=stallm_session
SESSION_SAMESITE=Lax
SESSION_SECURE_COOKIE=0

PAYMONGO_SECRET_KEY=sk_test_replace_with_your_key
PAYMONGO_WEBHOOK_TOKEN=replace_with_strong_random_token

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025  
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@stallm.com"
MAIL_FROM_NAME="Center Point Stall Management"

# Mailjet Configuration (Used for Production Email)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# SMS Configuration (Local: SMS Catcher Dashboard, Prod: Semaphore)
SMS_CATCHER_ENABLED=true
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=STALLM

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Facebook OAuth Configuration
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# --- Production (set these on the live server) ---
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# Content-Security-Policy: enforce | report | off
CSP_MODE=enforce
