APP_NAME=StallManage
APP_URL=http://localhost
APP_BASE_PATH=/stallm
ENABLE_2FA=true
APP_DEBUG=0
APP_ERROR_PAGE_ENABLED=1

DB_HOST=localhost
DB_NAME=stallm
DB_USER=root
DB_PASS=

SESSION_NAME=stallm_session
SESSION_SAMESITE=Lax
SESSION_SECURE_COOKIE=0

